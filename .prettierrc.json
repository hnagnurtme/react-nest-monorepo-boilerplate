{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "overrides": [
    { "files": "*.md", "options": { "printWidth": 120, "proseWrap": "preserve" } },
    { "files": "*.json", "options": { "printWidth": 120 } }
  ]
}
