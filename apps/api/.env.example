# ---------------------------------------------------------------------------
# apps/api — every variable declared in src/config/env.schema.ts must appear
# here. CI compares the two lists (docs/rules/10-infra-devops.md).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=api
LOG_LEVEL=debug

# Runtime role: DML only, NOBYPASSRLS. Never point this at the owner role —
# owning the tables would silently disable RLS.
DATABASE_URL=postgres://boilerplate_app:app@localhost:5432/boilerplate_dev
# Privileged connection used by drizzle-kit and src/core/database/migrate.ts
# only. It has to be able to CREATE ROLE on a fresh database; migrate.ts then
# SET ROLEs down to boilerplate_owner for the migrations themselves.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/boilerplate_dev
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# openssl rand -hex 32 — two DIFFERENT values. A shared secret would let a
# leaked access secret mint refresh tokens.
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_fedcba9876543210
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OWASP minimum for Argon2id (19 MiB).
ARGON2_MEMORY_COST=19456

CORS_ORIGINS=http://localhost:5173,http://localhost:4173
WEB_ORIGIN=http://localhost:5173

COOKIE_DOMAIN=
COOKIE_SECURE=false
CSRF_COOKIE_NAME=csrf_token

OTEL_SERVICE_NAME=api
# Leave blank to disable trace export; spans are still created so traceId works.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Email SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="App <no-reply@example.com>"
