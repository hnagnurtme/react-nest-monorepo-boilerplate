# ---------------------------------------------------------------------------
# apps/api — every variable declared in src/config/env.schema.ts must appear
# here. CI compares the two lists (docs/rules/10-infra-devops.md).
# ---------------------------------------------------------------------------

NODE_ENV=development
# Product name used in emails and the API docs title.
APP_NAME="Starter App"
PORT=3000
API_PREFIX=api
LOG_LEVEL=debug

# Runtime role: DML only, NOBYPASSRLS. Never point this at the owner role —
# owning the tables would silently disable RLS.
DATABASE_URL=postgres://boilerplate_app:app@localhost:5432/boilerplate_dev
# Privileged connection used by drizzle-kit and src/core/database/migrate.ts
# only. It has to be able to CREATE ROLE on a fresh database; migrate.ts then
# SET ROLEs down to boilerplate_owner for the migrations themselves.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/boilerplate_dev
DATABASE_POOL_MAX=10

REDIS_URL=redis://localhost:6379

# openssl rand -hex 32 — two DIFFERENT values. A shared secret would let a
# leaked access secret mint refresh tokens.
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_fedcba9876543210
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# OWASP minimum for Argon2id (19 MiB).
ARGON2_MEMORY_COST=19456

CORS_ORIGINS=http://localhost:5173,http://localhost:4173
WEB_ORIGIN=http://localhost:5173

# Reverse proxies in front of the API (Express `trust proxy`). 1 behind nginx,
# 0 when clients reach the API directly — a trusted hop that is not there lets
# a client pick its own IP through X-Forwarded-For, and a missing one puts
# every client in the same per-IP throttle bucket.
TRUST_PROXY_HOPS=0

COOKIE_DOMAIN=
COOKIE_SECURE=false
CSRF_COOKIE_NAME=csrf_token

OTEL_SERVICE_NAME=api
# The three observability switches. Each is independent and each is off when
# blank; `just observability` starts the local stack they point at (Tempo,
# Prometheus, Loki, Grafana — docker compose profile `tracing`). Point one at a
# backend that is not running and it retries in the background, so leave it
# blank rather than stale.
#
# Traces. Blank still creates spans, so traceId keeps correlating the logs.
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
# Metrics. Opens a scrape endpoint on its own port (http://localhost:9464/metrics),
# not a route on the API, so it never sits behind the auth stack. Prometheus
# scrapes it; blank means no meter and no listener.
#   PROMETHEUS_METRICS_PORT=9464
PROMETHEUS_METRICS_PORT=
# Logs. Ships the same Pino lines to Loki, labelled by service and env, so
# Grafana can jump from a span to the lines carrying its traceId.
#   LOKI_URL=http://localhost:3100
LOKI_URL=

# Sentry-compatible DSN (self-hosted Bugsink/GlitchTip or Sentry). Blank = off.
SENTRY_DSN=

# Object storage (MinIO locally via `just up`, any S3-compatible service in
# production). Blank S3_ENDPOINT switches uploads off: they answer 503 rather
# than a stack trace. The bucket is private — the API signs a short-lived URL
# per request and never hands a browser a bucket URL.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=app-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# MinIO serves buckets as a path; AWS wants a subdomain.
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900
S3_MAX_UPLOAD_BYTES=2097152

# Email SMTP Configuration.
# Dev points at Mailpit (`just up`, UI on `just mail`), never at a real relay:
# a developer machine aimed at production mails real addresses, and a retry
# burst is what gets an IP blocked. Keep SMTP_USER/SMTP_PASS non-blank even for
# Mailpit — MailService builds no transporter when either is empty and only
# logs `[Mail DEV MOCK]`, so the SMTP path would be exercised by nobody.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev
SMTP_PASS=dev
SMTP_FROM="Starter App <no-reply@example.com>"

# How long an invitation link stays valid (hours, 1..168).
INVITATION_TTL_HOURS=72

# Email branding. Absolute public URLs only — mail clients fetch them from the
# recipient's network. Leave blank to fall back to plain text / flat colour.
MAIL_LOGO_URL=
MAIL_BACKGROUND_URL=
MAIL_BRAND_COLOR=#2563eb
MAIL_SUPPORT_EMAIL=
