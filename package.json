{
  "name": "nest-react-turbo-boilerplate",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml}\"",
    "db:generate": "turbo run db:generate --filter=@repo/api",
    "db:migrate": "turbo run db:migrate --filter=@repo/api",
    "db:seed": "turbo run db:seed --filter=@repo/api",
    "db:studio": "turbo run db:studio --filter=@repo/api",
    "contract:generate": "turbo run export:openapi --filter=@repo/api && pnpm --filter @repo/api-contract generate",
    "secrets:scan": "if ! command -v gitleaks >/dev/null 2>&1; then echo 'gitleaks is required. Install it from https://github.com/gitleaks/gitleaks.' >&2; exit 1; fi; gitleaks detect --config .gitleaks.toml --no-banner --redact",
    "audit:ci": "node scripts/audit.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": ">=1.1.19",
      "brace-expansion@2": ">=2.1.5",
      "brace-expansion@5": ">=5.0.10",
      "handlebars": ">=4.7.9",
      "@vitest/mocker": ">=4.1.11",
      "@xmldom/xmldom": ">=0.8.15",
      "multer": ">=2.4.0",
      "postcss": ">=8.5.23",
      "tar": ">=7.5.21",
      "uuid": ">=11.1.1",
      "vitest": ">=4.1.11",
      "@grpc/grpc-js": ">=1.14.5",
      "fast-uri": ">=3.1.8",
      "js-yaml@5": ">=5.4.1",
      "source-map-js": ">=1.2.2",
      "proxy-addr": ">=2.0.8",
      "esbuild@0.18": ">=0.25.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
